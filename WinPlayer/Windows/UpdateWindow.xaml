<Window x:Class="WinPlayer.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление"
        Width="360" Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">
  <Border Background="{StaticResource GlassFillBrush}"
          BorderBrush="{StaticResource GlassStrokeBrush}"
          BorderThickness="1"
          CornerRadius="22"
          Padding="22">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Позже"
                Style="{StaticResource GlassDialogButton}"
                Margin="0,0,10,0"
                Click="Later_Click"/>
        <Button Content="Скачать"
                Style="{StaticResource GlassPrimaryButton}"
                Click="Download_Click"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="ОБНОВЛЕНИЕ"
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   FontFamily="{StaticResource UiFont}"
                   Margin="0,0,0,10"/>
        <TextBlock x:Name="TitleText"
                   Text="Доступна новая версия"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   FontFamily="{StaticResource UiFont}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <TextBlock x:Name="NotesText"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="13"
                   FontFamily="{StaticResource UiFont}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
