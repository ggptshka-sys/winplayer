<Window x:Class="WinPlayer.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Об авторе"
        Width="340" Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">
  <Border Background="{StaticResource GlassFillBrush}"
          BorderBrush="{StaticResource GlassStrokeBrush}"
          BorderThickness="1"
          CornerRadius="22"
          Padding="22">
    <DockPanel LastChildFill="True">
      <Button DockPanel.Dock="Bottom"
              Content="Закрыть"
              Style="{StaticResource GlassDialogButton}"
              HorizontalAlignment="Right"
              Margin="0,18,0,0"
              Click="Close_Click"/>

      <StackPanel>
        <TextBlock Text="W · PLAYER"
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   FontFamily="{StaticResource UiFont}"
                   Margin="0,0,0,10"/>
        <TextBlock Text="Компактный SMTC-виджет для Windows."
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   FontFamily="{StaticResource UiFont}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <TextBlock Text="Управление музыкой из браузера и приложений прямо с рабочего стола."
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="13"
                   FontFamily="{StaticResource UiFont}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>
        <TextBlock FontFamily="{StaticResource UiFont}" FontSize="13">
          <Run Foreground="{StaticResource TextDimBrush}" Text="Telegram: "/>
          <Hyperlink NavigateUri="https://t.me/ptrchkov" RequestNavigate="Telegram_RequestNavigate">
            <Run Text="@ptrchkov" Foreground="#9ECBFF"/>
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
